{
  "action": "rules.update",
  "id": "rule_celeste_gemini_api_rate_limit_o1N0Tn",
  "value": {
    "name": "Celeste Gemini API rate limit",
    "description": "Protege cenas, sonhos, traducao, voz e visuais Gemini contra abuso distribuido",
    "active": true,
    "conditionGroup": [
      {
        "conditions": [
          {
            "type": "path",
            "op": "eq",
            "value": "/api/gerar-cena"
          },
          {
            "type": "method",
            "op": "eq",
            "value": "POST"
          }
        ]
      },
      {
        "conditions": [
          {
            "type": "path",
            "op": "eq",
            "value": "/api/traduzir-cena"
          },
          {
            "type": "method",
            "op": "eq",
            "value": "POST"
          }
        ]
      },
      {
        "conditions": [
          {
            "type": "path",
            "op": "eq",
            "value": "/api/transformar-sonho"
          },
          {
            "type": "method",
            "op": "eq",
            "value": "POST"
          }
        ]
      },
      {
        "conditions": [
          {
            "type": "path",
            "op": "eq",
            "value": "/api/gerar-audio"
          },
          {
            "type": "method",
            "op": "eq",
            "value": "POST"
          }
        ]
      },
      {
        "conditions": [
          {
            "type": "path",
            "op": "eq",
            "value": "/api/gerar-visual"
          },
          {
            "type": "method",
            "op": "eq",
            "value": "POST"
          }
        ]
      }
    ],
    "action": {
      "mitigate": {
        "redirect": null,
        "action": "rate_limit",
        "rateLimit": {
          "limit": 12,
          "action": "deny",
          "window": 60,
          "algo": "fixed_window",
          "keys": [
            "ip",
            "ja4"
          ]
        },
        "actionDuration": "1m"
      }
    }
  }
}

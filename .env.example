# Projeto Supabase exclusivo da Celeste. Use somente a chave anon no app;
# service_role nunca pode entrar no bundle Expo.
EXPO_PUBLIC_SUPABASE_URL=
# Nome atual recomendado pelo Supabase Marketplace.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compatibilidade com projetos Supabase que ainda fornecem a chave anon JWT.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# A Comunidade continua local por padrao. Esta flag publica so habilita o cliente;
# o kill switch da migration 007 tambem precisa estar habilitado no banco.
EXPO_PUBLIC_CELESTE_COMMUNITY_REMOTE_ENABLED=0

# Mesmos projeto/anon acima, usados somente pelo backend para validar sessoes.
CELESTE_SUPABASE_URL=
CELESTE_SUPABASE_ANON_KEY=
# Segredo exclusivo da Vercel. Nunca copie para EXPO_PUBLIC_* nem para o app.
CELESTE_SUPABASE_SERVICE_ROLE_KEY=
# Segredo aleatorio exclusivo, com pelo menos 32 bytes, marcado Sensitive na
# Vercel. Mantenha estavel: rotaciona-lo reinicia a cota de origem do dia.
CELESTE_ACTOR_HASH_SECRET=
# A integracao oficial tambem pode fornecer SUPABASE_URL,
# SUPABASE_PUBLISHABLE_KEY e SUPABASE_SECRET_KEY automaticamente.

# Base pública do backend Celeste para builds iOS/Android. Não contém segredo.
EXPO_PUBLIC_CELESTE_API_URL=https://celeste-jet-two.vercel.app

# Somente Vercel/backend. NUNCA use prefixo EXPO_PUBLIC nestas variáveis.
ANTHROPIC_API_KEY=
ANTHROPIC_TEXT_MODEL=claude-sonnet-5
ANTHROPIC_TEXT_EFFORT=medium
ANTHROPIC_PAID_DATA_TERMS_ACCEPTED=0
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-terra
OPENAI_TEXT_REASONING_EFFORT=medium
OPENAI_PAID_DATA_TERMS_ACCEPTED=0
# Textos: Claude principal, OpenAI como contingencia. Enquanto nenhuma dessas
# chaves estiver configurada, a API mantem o Gemini abaixo como compatibilidade.
CELESTE_TEXT_PRIMARY=anthropic
CELESTE_TEXT_FALLBACK=openai
CELESTE_TEXT_PROVIDER_TIMEOUT_MS=18000
CELESTE_TEXT_FALLBACK_RESERVE_MS=9000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_IMAGE_TIMEOUT_MS=35000
# Ligue apenas em projeto Google faturado, após aceitar os termos de dados pagos.
GEMINI_PAID_DATA_TERMS_ACCEPTED=0
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_TTS_TIMEOUT_MS=20000
CELESTE_ALLOWED_ORIGINS=https://celeste-jet-two.vercel.app
# Bypass apenas para `vercel dev` local. Preview e producao sempre fecham no BotID.
CELESTE_ALLOW_LOCAL_BOT_BYPASS=0
# Bypass nativo apenas para `vercel dev`. Producao exige App Attest/Play Integrity.
CELESTE_ALLOW_LOCAL_NATIVE_BYPASS=0

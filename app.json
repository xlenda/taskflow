{
  "expo": {
    "name": "Celeste",
    "slug": "celeste",
    "scheme": "celeste",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-celeste-v2.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "buildNumber": "1",
      "bundleIdentifier": "com.lenda.celeste",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSAlarmKitUsageDescription": "A Celeste usa alarmes para acordar você com a afirmação que você escolheu.",
        "NSMicrophoneUsageDescription": "A Celeste usa o microfone somente quando você toca para conferir duas repetições da afirmação exibida na tela. O áudio não é armazenado.",
        "NSSpeechRecognitionUsageDescription": "A Celeste usa reconhecimento de fala no aparelho para conferir duas repetições da afirmação exibida. A transcrição não é armazenada."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/mascot/celi.png",
        "backgroundColor": "#AFC8E7"
      },
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "versionCode": 1,
      "package": "com.lenda.celeste"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "microphonePermission": "A Celeste usa o microfone somente quando você toca para conferir duas repetições da afirmação exibida na tela. O áudio não é armazenado.",
          "recordAudioAndroid": false
        }
      ],
      "expo-video",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E6EFF8"
        }
      ],
      "expo-notifications",
      "expo-image",
      "expo-font",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "cf0cf418-4ce2-4e5f-8155-8662d5965a03"
      }
    },
    "owner": "naturallens"
  }
}

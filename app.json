{
  "expo": {
    "name": "Celeste",
    "slug": "celeste",
    "scheme": "celeste",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#E6EFF8"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lenda.celeste",
      "infoPlist": {
        "NSAlarmKitUsageDescription": "A Celeste usa alarmes para acordar você com a afirmação que você escolheu."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#AFC8E7"
      },
      "package": "com.lenda.celeste"
    },
    "plugins": [
      "expo-video",
      "expo-notifications"
    ]
  }
}
